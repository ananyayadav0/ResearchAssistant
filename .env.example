# LLM backend: Ollama (default, local) or Groq
USE_GROQ=false
OLLAMA_MODEL=llama3
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=8192
GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_API_KEY=your-key-here

# Storage
DB_DIR=chroma_db
DATA_DIR=data

# Reranker relevance cutoff (0-1, after sigmoid)
MIN_RERANK_SCORE=0.001
